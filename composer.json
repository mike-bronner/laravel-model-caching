{
    "name": "mike-bronner/laravel-model-caching",
    "description": "Automatic caching for Eloquent models.",
    "license": "MIT",
    "authors": [
        {
            "name": "Mike Bronner",
            "email": "hello@genealabs.com"
        }
    ],
    "replace": {
        "genealabs/laravel-model-caching": "self.version",
        "mikebronner/laravel-model-caching": "self.version"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "git@github.com:mikebronner/development-settings.git",
            "only": [
                "mikebronner/development-settings"
            ]
        },
        {
            "type": "vcs",
            "url": "git@github.com:mike-bronner/phpcs-rules.git",
            "only": [
                "mike-bronner/phpcs-rules"
            ]
        }
    ],
    "require": {
        "php": ">=8.3",
        "mikebronner/laravel-pivot-events": "^13.1",
        "illuminate/cache": "^12.0|^13.0",
        "illuminate/config": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/container": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "aws/aws-sdk-php": "^3.322.9",
        "doctrine/dbal": "^3.3|^4.2",
        "fakerphp/faker": "^1.11",
        "larastan/larastan": "^2.0|^3.0",
        "laravel/boost": "^2.0",
        "laravel/pint": "^1.27",
        "mike-bronner/phpcs-rules": "dev-main",
        "mikebronner/development-settings": "^0.3.0",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.5",
        "predis/predis": "^2.0|^3.0",
        "squizlabs/php_codesniffer": "^3.6|^4.0",
        "symfony/thanks": "^1.2"
    },
    "autoload": {
        "psr-4": {
            "GeneaLabs\\LaravelModelCaching\\": "src/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "tests/database/seeds"
        ],
        "psr-4": {
            "GeneaLabs\\LaravelModelCaching\\Tests\\": "tests/",
            "GeneaLabs\\LaravelModelCaching\\Tests\\Database\\Factories\\": "tests/database/factories/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "GeneaLabs\\LaravelModelCaching\\Providers\\Service"
            ]
        }
    },
    "suggest": {
        "aws/aws-sdk-php": "Required for DynamoDB cache store support (^3.322)"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=2G",
        "test": "phpunit --configuration phpunit.xml.dist --testsuite Integration,Feature"
    },
    "scripts-descriptions": {
        "analyse": "Run PHPStan at level 5. Enforced in CI on every pull request. The pre-existing findings are recorded in phpstan-baseline.neon, so a clean run means you introduced nothing new.",
        "test": "Run the test suite the way CI runs it. Requires a reachable Redis."
    },
    "config": {
        "allow-plugins": {
            "symfony/thanks": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "mikebronner/development-settings": true
        }
    }
}
